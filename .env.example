# Copy to .env.local (git-ignored) and fill in from the stack outputs:
#
#   aws cloudformation describe-stacks --stack-name facial-recog \
#     --query 'Stacks[0].Outputs[?OutputKey==`ApiBaseUrl`].OutputValue' --output text
#
# Create React App inlines this at build time, so it is baked into the bundle
# and is public. That is fine -- the endpoint is meant to be reachable from the
# browser, and it is protected by throttling and key validation, not secrecy.
# Never put anything here that is actually secret.
REACT_APP_API_BASE_URL=https://your-api-id.execute-api.us-east-2.amazonaws.com/dev
